{
  "name": "twitch-clipper",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev:app --workspace=apps/frontend",
    "dev:backend": "cd apps/backend && uv run python -m src.main",
    "build": "npm run build --workspaces",
    "package": "npm run package --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "allowScripts": {
    "electron@30.5.1": true,
    "esbuild@0.21.5": true
  }
}
